{% extends 'base.html.twig' %}

{% block title %}Aurix{% endblock %}

{% block body %}
    <div class="mx-auto flex min-h-screen w-full max-w-xl flex-col px-4 py-6 sm:py-10">
        <header class="mb-8 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <svg class="h-9 w-9 text-[#4fb3a6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M3 12h2M7 8.5v7M11 5v14M15 9v6M19 10.5h2" />
                </svg>
                <div>
                    <p class="text-lg font-semibold tracking-tight text-[#efefef]">aurix</p>
                    <p class="text-xs text-[#7d7b7b]">Panel użytkownika</p>
                </div>
            </div>

            <div class="text-right text-xs text-[#7d7b7b]">
                <div class="mb-1 text-[#b4b0b0]">{{ app.user.userIdentifier }}</div>
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="underline underline-offset-4 transition hover:text-[#efefef]">Wyloguj</button>
                </form>
            </div>
        </header>

        <div class="rounded-xl border border-[#2a2828] bg-[#121214] p-6 sm:p-8">
            <div class="flex items-center gap-2.5 text-xs uppercase tracking-wide text-[#4fb3a6]">
                <span class="h-2 w-2 rounded-full bg-[#4fb3a6]"></span>
                Profil aktywny
            </div>

            {% for result in app.flashes('voice_result') %}
                <div class="mt-4 rounded-md border border-[#1f4d43] bg-[#0f2a25] px-4 py-3">
                    <p class="text-sm text-[#4fb3a6]">Weryfikacja głosu udana</p>
                    <p class="mt-1 text-xs text-[#7d7b7b]">
                        similarity {{ result.similarity|number_format(3) }}
                        · fraza {{ result.phraseMatch|number_format(2) }}
                        · PAD {{ result.padScore|number_format(3) }} (diagnostycznie)
                    </p>
                </div>
            {% endfor %}

            <h1 class="mt-3 text-2xl font-bold leading-tight text-[#efefef]">
                Witaj, {{ app.user.userIdentifier }}.
            </h1>
            <p class="mt-2 text-sm leading-6 text-[#7d7b7b]">
                Twój głos jest zapisany jako trzy zaszyfrowane próbki referencyjne.
                Przy każdym logowaniu wystarczy powiedzieć jedną z nich.
            </p>

            <div class="mt-6 divide-y divide-[#2a2828] border-t border-[#2a2828]">
                {% for sample in samples %}
                    <div class="flex items-center gap-4 py-4">
                        <span class="text-xs text-[#7d7b7b]">0{{ sample.phraseIndex }}</span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm text-[#efefef]">{{ sample.phrase }}</p>
                            <p class="mt-0.5 text-xs text-[#7d7b7b]">zapisano {{ sample.createdAt|date('d.m.Y H:i') }}</p>
                        </div>
                        <span class="rounded-full bg-[#123a33] px-2.5 py-1 text-[10px] uppercase tracking-wide text-[#4fb3a6]">gotowa</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        <p class="mt-6 text-center text-xs leading-6 text-[#7d7b7b]">
            Wylogowanie czyści sesję. Kolejne logowanie wymaga hasła i głosu.
        </p>
    </div>
{% endblock %}
