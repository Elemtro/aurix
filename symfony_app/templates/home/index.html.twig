{% extends 'base.html.twig' %}

{% block title %}Aurix — weryfikacja głosu{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg: #0b1020;
            --panel: #141a2e;
            --panel-2: #1b2340;
            --text: #e8ecf8;
            --muted: #8b95b5;
            --accent: #5b8cff;
            --ok: #35d07f;
            --bad: #ff5c72;
            --border: rgba(255, 255, 255, .08);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: var(--text);
            background:
                radial-gradient(1200px 600px at 50% -10%, #1d2a55 0%, transparent 60%),
                var(--bg);
        }

        .shell { width: 100%; max-width: 560px; }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .brand-mark {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: linear-gradient(135deg, #5b8cff, #8f5bff);
            font-size: 22px;
        }

        .brand h1 { margin: 0; font-size: 1.35rem; letter-spacing: .02em; }
        .brand p { margin: 2px 0 0; color: var(--muted); font-size: .82rem; }

        .card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 28px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
        }

        .status {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted);
            font-size: .9rem;
            margin-bottom: 22px;
        }

        .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--muted);
            transition: background .2s;
        }

        .dot.recording { background: var(--bad); animation: pulse 1.2s infinite; }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .35; }
        }

        button {
            width: 100%;
            border: 0;
            border-radius: 12px;
            padding: 14px 18px;
            font: inherit;
            font-weight: 600;
            color: var(--text);
            background: var(--panel-2);
            cursor: pointer;
            transition: transform .08s, filter .2s;
        }

        button:hover { filter: brightness(1.15); }
        button:active { transform: translateY(1px); }

        button.primary { background: linear-gradient(135deg, #4f7cff, #7a5cff); }

        audio {
            width: 100%;
            margin-top: 18px;
            border-radius: 10px;
        }

        .hint {
            margin: 18px 0 0;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.5;
        }

        code {
            background: rgba(255, 255, 255, .07);
            padding: 1px 5px;
            border-radius: 5px;
            font-size: .92em;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="shell" data-voice-demo>
        <div class="brand">
            <div class="brand-mark">🎙️</div>
            <div>
                <h1>Aurix</h1>
                <p>Weryfikacja głosu — warstwa demonstracyjna</p>
            </div>
        </div>

        <section class="card">
            <div class="status">
                <span class="dot" id="dot"></span>
                <span id="status">Gotowy do nagrania</span>
            </div>

            <button type="button" class="primary" id="record">🎤 Nagraj próbkę</button>

            <audio id="playback" controls hidden></audio>

            <p class="hint">
                To tymczasowy frontend (Faza 1). Interfejs nagrywania działa lokalnie;
                wysyłka do silnika weryfikacji wróci razem z docelowymi endpointami
                <code>/api/enroll</code> i <code>/api/verify</code>.
            </p>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const dot = document.getElementById('dot');
            const statusEl = document.getElementById('status');
            const recordBtn = document.getElementById('record');
            const playback = document.getElementById('playback');

            let recorder = null;
            let stream = null;
            let chunks = [];

            recordBtn.addEventListener('click', async () => {
                if (recorder && recorder.state === 'recording') {
                    recorder.stop();
                    return;
                }

                try {
                    stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                } catch (error) {
                    statusEl.textContent = 'Brak dostępu do mikrofonu';
                    return;
                }

                chunks = [];
                recorder = new MediaRecorder(stream);

                recorder.ondataavailable = (event) => {
                    if (event.data.size > 0) {
                        chunks.push(event.data);
                    }
                };

                recorder.onstop = () => {
                    const blob = new Blob(chunks, { type: recorder.mimeType });
                    playback.src = URL.createObjectURL(blob);
                    playback.hidden = false;

                    stream.getTracks().forEach((track) => track.stop());

                    recordBtn.textContent = '🎤 Nagraj ponownie';
                    dot.classList.remove('recording');
                    statusEl.textContent = 'Nagranie gotowe (lokalnie)';
                };

                recorder.start();
                recordBtn.textContent = '⏹ Zatrzymaj nagrywanie';
                dot.classList.add('recording');
                statusEl.textContent = 'Nagrywanie…';
            });
        })();
    </script>
{% endblock %}
