{% extends 'base.html.twig' %}

{% block title %}Aurix — weryfikacja głosu{% endblock %}

{% block body %}
    <main
        class="flex min-h-screen items-center justify-center bg-slate-950 p-6 text-slate-100"
        data-controller="recorder"
    >
        <div class="w-full max-w-xl">
            <div class="mb-6 flex items-center gap-3">
                <div class="grid h-11 w-11 place-items-center rounded-xl bg-linear-to-br from-blue-500 to-violet-500 text-xl">
                    🎙️
                </div>
                <div>
                    <h1 class="text-xl font-semibold tracking-tight">Aurix</h1>
                    <p class="text-sm text-slate-400">Weryfikacja głosu — warstwa demonstracyjna</p>
                </div>
            </div>

            <section class="rounded-2xl border border-white/10 bg-slate-900/80 p-7 shadow-2xl shadow-black/40 backdrop-blur">
                <div class="mb-6 flex items-center gap-2.5 text-sm text-slate-400">
                    <span data-recorder-target="dot" class="h-2.5 w-2.5 rounded-full bg-slate-500"></span>
                    <span data-recorder-target="status">Gotowy do nagrania</span>
                </div>

                <button
                    type="button"
                    data-action="recorder#toggle"
                    data-recorder-target="button"
                    class="w-full rounded-xl bg-linear-to-r from-blue-500 to-violet-500 px-4 py-3.5 font-semibold text-white transition hover:brightness-110 active:translate-y-px"
                >
                    🎤 Nagraj próbkę
                </button>

                <audio
                    data-recorder-target="playback"
                    controls
                    hidden
                    class="mt-4 w-full rounded-lg"
                ></audio>

                <p class="mt-4 text-xs leading-relaxed text-slate-500">
                    To tymczasowy frontend (Faza 1). Interfejs nagrywania działa lokalnie;
                    wysyłka do silnika weryfikacji wróci razem z docelowymi endpointami
                    <code class="rounded bg-white/10 px-1.5 py-0.5">/api/enroll</code>
                    i
                    <code class="rounded bg-white/10 px-1.5 py-0.5">/api/verify</code>.
                </p>
            </section>
        </div>
    </main>
{% endblock %}
